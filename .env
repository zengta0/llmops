# Flask 基础配置
FLASK_DEBUG=1
FLASK_ENV=development

# wtf 配置
WTF_CSRF_ENABLED=False

# SQLALchemy数据库配置
SQLALCHEMY_DATABASE_URI=postgresql+psycopg://postgres:postgresql@localhost:5432/llmops?client_encoding=utf8
SQLALCHEMY_POOL_SIZE=30
SQLALCHEMY_POOL_RECYCLE=3600
SQLALCHEMY_ECHO=True

# OpenAI服务提供者
OPENAI_API_BASE=https://api.deepseek.com